    {
      "name": "6. Human Approvals (HITL)",
      "item": [
        {
          "name": "6.1 Get Pending Approvals",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/approvals/pending?workflow_id={{workflowId}}", "host": ["{{baseUrl}}"], "path": ["api", "approvals", "pending"], "query": [{ "key": "workflow_id", "value": "{{workflowId}}" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var list = pm.response.json();",
                  "if (list && list.length > 0) {",
                  "  pm.environment.set('approvalId', list[0].approval_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "6.2 Approve Pending Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewer\": \"Priya (Compliance Lead)\",\n  \"decision\": \"approved\",\n  \"comment\": \"Verified candidate consent form\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/approvals/{{approvalId}}/approve", "host": ["{{baseUrl}}"], "path": ["api", "approvals", "{{approvalId}}", "approve"] }
          }
        },
        {
          "name": "6.3 List Approval History",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/approvals/history?workflow_id={{workflowId}}", "host": ["{{baseUrl}}"], "path": ["api", "approvals", "history"], "query": [{ "key": "workflow_id", "value": "{{workflowId}}" }] }
          }
        }
      ]
    },
    {
      "name": "7. Verifications & Email Operations",
      "item": [
        {
          "name": "7.1 Submit Education Verification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workflow_id\": \"{{workflowId}}\",\n  \"candidate_name\": \"Rahul Sharma\",\n  \"institution\": \"ABC Engineering College\",\n  \"enrollment_number\": \"SYN-2020-1045\",\n  \"degree\": \"BTech\",\n  \"branch\": \"Computer Science Engineering\",\n  \"graduation_year\": 2024\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/verification/education", "host": ["{{baseUrl}}"], "path": ["api", "verification", "education"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var data = pm.response.json();",
                  "  pm.environment.set('verificationId', data.verification_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "7.2 Inject Simulated University Confirmation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workflow_id\": \"{{workflowId}}\",\n  \"sender\": \"registrar@abc-engineering.edu.test\",\n  \"subject\": \"RE: Education Verification\",\n  \"body\": \"We confirm that Rahul Sharma completed BTech in Computer Science Engineering in 2024.\",\n  \"outcome\": \"confirmed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/email/mock-replies", "host": ["{{baseUrl}}"], "path": ["api", "email", "mock-replies"] }
          }
        },
        {
          "name": "7.3 Inspect Email Inbox",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/email/inbox?workflow_id={{workflowId}}", "host": ["{{baseUrl}}"], "path": ["api", "email", "inbox"], "query": [{ "key": "workflow_id", "value": "{{workflowId}}" }] }
          }
        }
      ]
    },
