{
  "info": {
    "name": "Enterprise Autonomous Onboarding & Verification System",
    "description": "Complete Postman test collection for testing the entire multi-agent onboarding, verification, approval, salary, red-flag, and recovery AI pipeline.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. System & LLM APIs",
      "item": [
        {
          "name": "1.1 Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Health status ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 System Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/system/info", "host": ["{{baseUrl}}"], "path": ["api", "system", "info"] }
          }
        },
        {
          "name": "1.3 List LLM Providers",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/llm/providers", "host": ["{{baseUrl}}"], "path": ["api", "llm", "providers"] }
          }
        },
        {
          "name": "1.4 Test Gemini Live Provider",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"gemini\",\n  \"prompt\": \"Verify candidate degree in 5 words\",\n  \"system_message\": \"You are an enterprise AI verifier.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/llm/test", "host": ["{{baseUrl}}"], "path": ["api", "llm", "test"] }
          }
        },
        {
          "name": "1.5 Test Grok / Groq Live Provider",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"groq\",\n  \"prompt\": \"Explain employee verification in 5 words\",\n  \"system_message\": \"You are an enterprise AI verifier.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/llm/test", "host": ["{{baseUrl}}"], "path": ["api", "llm", "test"] }
          }
        }
      ]
    },
    {
      "name": "2. Employee Management",
      "item": [
        {
          "name": "2.1 Create Employee Record",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Rahul\",\n  \"last_name\": \"Sharma\",\n  \"email\": \"rahul.sharma@enterprise.test\",\n  \"department\": \"Platform Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"annual_ctc\": 1200000,\n  \"location\": \"Bengaluru\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/employees", "host": ["{{baseUrl}}"], "path": ["api", "employees"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var data = pm.response.json();",
                  "  pm.environment.set('employeeId', data.employee_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 List Employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/employees", "host": ["{{baseUrl}}"], "path": ["api", "employees"] }
          }
        },
        {
          "name": "2.3 Get Employee by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/employees/{{employeeId}}", "host": ["{{baseUrl}}"], "path": ["api", "employees", "{{employeeId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Workflow Orchestration",
      "item": [
        {
          "name": "3.1 Start Onboarding Workflow",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goal\": \"Onboard Rahul Sharma as Software Engineer in Platform Engineering with complete qualification verification and payroll setup\",\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul.sharma@enterprise.test\",\n  \"department\": \"Platform Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"annual_ctc\": 1200000,\n  \"university\": \"ABC Engineering College\",\n  \"enrollment_number\": \"SYN-2020-1045\",\n  \"degree\": \"BTech\",\n  \"branch\": \"Computer Science Engineering\",\n  \"graduation_year\": 2024,\n  \"previous_employer\": \"Tech Innovators Inc\",\n  \"previous_designation\": \"Junior Engineer\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/workflows/onboarding", "host": ["{{baseUrl}}"], "path": ["api", "workflows", "onboarding"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var data = pm.response.json();",
                  "  pm.environment.set('workflowId', data.workflow_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.2 Get Workflow Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/workflows/{{workflowId}}", "host": ["{{baseUrl}}"], "path": ["api", "workflows", "{{workflowId}}"] }
          }
        },
        {
          "name": "3.3 Get Workflow Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/tasks", "host": ["{{baseUrl}}"], "path": ["api", "workflows", "{{workflowId}}", "tasks"] }
          }
        },
        {
          "name": "3.4 Pause Workflow",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/pause", "host": ["{{baseUrl}}"], "path": ["api", "workflows", "{{workflowId}}", "pause"] }
          }
        },
        {
          "name": "3.5 Resume Workflow",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/resume", "host": ["{{baseUrl}}"], "path": ["api", "workflows", "{{workflowId}}", "resume"] }
          }
        },
        {
          "name": "3.6 Re-plan Workflow",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Candidate requested updated designation to Senior Platform Engineer\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/replan", "host": ["{{baseUrl}}"], "path": ["api", "workflows", "{{workflowId}}", "replan"] }
          }
        }
      ]
    },
