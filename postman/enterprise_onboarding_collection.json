          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved_ctc\": 1200000,\n  \"structure\": {\n    \"annual_ctc\": 1200000,\n    \"basic\": 480000,\n    \"hra\": 240000,\n    \"special_allowance\": 360000,\n    \"employer_pf\": 57600,\n    \"other_benefits\": 62400\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/finance/salary/validate", "host": ["{{baseUrl}}"], "path": ["api", "finance", "salary", "validate"] }
